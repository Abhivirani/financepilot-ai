# Copy to .env and fill in real values. Never commit the real .env file.

# --- App ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# --- AI provider ---
ANTHROPIC_API_KEY=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- File storage (local for MVP) ---
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports

# --- Reconciliation tuning (placeholders, no logic yet) ---
MATCH_AMOUNT_TOLERANCE=0.01
MAX_BATCH_SIZE=500
